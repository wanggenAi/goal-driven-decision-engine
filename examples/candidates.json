{
  "schema_version": "1.0",
  "as_of": "2026-10-22T10:00:00+08:00",
  "goal": {
    "id": "opportunity_screening",
    "description": "Prioritize candidates for investigation, not purchasing decisions",
    "success_measure": "realized_net_profit_30d"
  },
  "decision": {
    "min_score": 70,
    "max_age_hours": 72
  },
  "dimensions": [
    {
      "id": "economics",
      "weight": 0.5,
      "metrics": [
        {
          "id": "unit_profit",
          "expression": "sale_price - purchase_cost - fees - service_cost",
          "weight": 1,
          "normalize": {
            "low": 0,
            "high": 50,
            "direction": "higher"
          }
        }
      ]
    },
    {
      "id": "momentum",
      "weight": 0.3,
      "metrics": [
        {
          "id": "growth_rate",
          "expression": "sales_recent / sales_previous - 1",
          "weight": 1,
          "normalize": {
            "low": 0,
            "high": 2,
            "direction": "higher"
          }
        }
      ]
    },
    {
      "id": "quality",
      "weight": 0.2,
      "metrics": [
        {
          "id": "refund_rate",
          "expression": "refund_count / fulfilled_count",
          "weight": 1,
          "normalize": {
            "low": 0,
            "high": 0.2,
            "direction": "lower"
          }
        }
      ]
    }
  ],
  "gates": [
    {
      "metric": "unit_profit",
      "op": ">",
      "value": 0
    },
    {
      "metric": "refund_rate",
      "op": "<=",
      "value": 0.1
    }
  ],
