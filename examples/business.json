    {
      "id": "q_economics",
      "goal_id": "business",
      "question": "Can this candidate earn a positive contribution margin?",
      "metrics": [
        "unit_profit"
      ]
    },
    {
      "id": "q_demand",
      "goal_id": "business",
      "question": "Is demand growing?",
      "metrics": [
        "growth"
      ]
    },
    {
      "id": "q_risk",
      "goal_id": "business",
      "question": "Are refund and competition risks acceptable?",
      "metrics": [
        "refund_rate",
        "competition"
      ]
    }
