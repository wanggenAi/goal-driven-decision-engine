  "dimensions": [
    {
      "id": "economics",
      "weight": 0.4,
      "weight_basis": "Explicit illustrative stakeholder priority; not an optimized weight.",
      "metrics": [
        {
          "id": "unit_profit",
          "expression": "price - cost - fees",
          "inputs": [
            "price",
            "cost",
            "fees"
          ],
          "unit": "CNY/unit",
          "direction": "higher",
          "normalize": {
            "method": "min_max",
            "low": 0,
            "high": 50,
            "basis": "Illustrative expert anchors fixed before this synthetic evaluation; not calibrated."
          },
          "weight": 1,
          "weight_basis": "Equal local priority within this dimension; illustrative judgment.",
          "explanation": "Price minus purchase and service costs; contribution margin per unit",
          "evidence_requirements": {
            "allowed_kinds": [
              "observed",
              "estimated",
              "synthetic"
            ],
            "independently_verified": false,
            "max_age_hours": 72,
            "window_required": true
          }
        }
      ]
    },
    {
      "id": "demand",
      "weight": 0.25,
      "weight_basis": "Explicit illustrative stakeholder priority; not an optimized weight.",
      "metrics": [
        {
          "id": "growth",
          "expression": "recent / previous - 1",
          "inputs": [
            "recent",
            "previous"
          ],
          "unit": "1",
          "direction": "higher",
          "normalize": {
            "method": "min_max",
            "low": 0,
            "high": 1,
            "basis": "Illustrative expert anchors fixed before this synthetic evaluation; not calibrated."
          },
          "weight": 1,
          "weight_basis": "Equal local priority within this dimension; illustrative judgment.",
          "explanation": "Recent versus previous demand change",
          "evidence_requirements": {
            "allowed_kinds": [
              "observed",
              "estimated",
              "synthetic"
            ],
            "independently_verified": false,
            "max_age_hours": 72,
            "window_required": true
          }
        }
      ]
    },
    {
      "id": "risk",
      "weight": 0.35,
      "weight_basis": "Explicit illustrative stakeholder priority; not an optimized weight.",
      "metrics": [
        {
          "id": "refund_rate",
          "expression": "refunds / orders",
          "inputs": [
            "refunds",
            "orders"
          ],
          "unit": "1",
          "direction": "lower",
          "normalize": {
            "method": "min_max",
            "low": 0,
            "high": 0.2,
            "basis": "Illustrative expert anchors fixed before this synthetic evaluation; not calibrated."
          },
          "weight": 4,
          "weight_basis": "Equal local priority within this dimension; illustrative judgment.",
          "explanation": "Fraction of orders refunded",
          "evidence_requirements": {
            "allowed_kinds": [
              "observed",
              "estimated",
              "synthetic"
            ],
            "independently_verified": false,
            "max_age_hours": 72,
            "window_required": true
          }
        },
        {
          "id": "competition",
